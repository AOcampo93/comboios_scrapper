# Postgres connection. In Coolify the BD is on the internal Docker network.
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/comboios

# Upstream public endpoint (Joao's site). Cached at 7s by upstream Next.js.
UPSTREAM_BASE=https://comboios.live/api

# CP static GTFS feed (published timetable). Used for scheduled-dwell + line mapping.
GTFS_URL=https://publico.cp.pt/gtfs/gtfs.zip

# User-Agent string sent with every request — identifies us, easy to block if needed.
SCRAPER_USER_AGENT=comboios-history-scraper/0.1 (research, non-commercial; contact: arturo.ocampo93@gmail.com)

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# production | development
NODE_ENV=production
