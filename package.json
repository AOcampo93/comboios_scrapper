{
    "name": "comboios-scrapper",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "typecheck": "tsc --noEmit",
        "seed": "tsx scripts/seed.ts",
        "seed:clean": "tsx scripts/seed.ts --clean",
        "seed:osm-geometry": "tsx scripts/seed-osm-geometry.ts",
        "backfill": "tsx src/scripts/backfill-gtfs.ts",
        "backfill-all": "tsx src/scripts/backfill-aggregations.ts"
    },
    "dependencies": {
        "fflate": "^0.8.3",
        "pg": "^8.11.5",
        "pino": "^9.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.12.0",
        "@types/pg": "^8.11.6",
        "pino-pretty": "^11.0.0",
        "tsx": "^4.7.2",
        "typescript": "^5.4.5"
    }
}
